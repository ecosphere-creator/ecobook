# MongoDB
MONGODB_URI=mongodb://localhost:27017/slides_dev

# JWT (must match the estate's shared secret -- this service only validates, never issues)
JWT_SECRET=

# Server
SERVER_PORT=9015
API_BASE_URL=http://localhost:9015/api

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Peer domain dependencies (resolved automatically by 'eco configure'
# when the peer service is composed into the same estate)
AUTH_BASE_URL=
COMMUNITY_BASE_URL=
PAYMENTS_BASE_URL=

# Object storage (MinIO/S3-compatible) for uploaded images
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=slides
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Rate limiting (per-source-IP token bucket shared across all routes:
# burst capacity, then 1 token/RATE_LIMIT_GENERAL_REPLENISH_SECS refill)
RATE_LIMIT_GENERAL_BURST=120
RATE_LIMIT_GENERAL_REPLENISH_SECS=1
